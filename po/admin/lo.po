#: src/web/clients/trustee/shuffle.ml:169
msgid "An error occurred while applying the shuffle."
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ກຳລັງດຳເນີນການສັບປ່ຽນ (shuffle)."

#: src/web/clients/admin/common.ml:125
msgid "An error occurred while retrieving elections: %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ດຶງຂໍ້ມູນການເລືອກຕັ້ງ: %s"

#: src/web/clients/credauth/generate.ml:74
msgid "An error occurred while submitting credentials!"
msgstr "ເກີດຂໍ້ຜິດພາດໃນຂະນະທີ່ສົ່ງສິດເຂົ້າໃຊ້!"

#: src/web/clients/admin/elections.ml:982
msgid "An identity is either \"address\", or \"address,username\", or \"address,username,weight\", or \"address,,weight\" where \"address\" is an e-mail address, \"username\" the associated user name for authentication, and \"weight\" is the number of votes of the voter (in case voters don't have all the same number of votes)."
msgstr ""
"ຕົວຕົນແມ່ນ \"ທີ່ຢູ່\", ຫຼື \"ທີ່ຢູ່,ຊື່ຜູ້ໃຊ້\", ຫຼື \"ທີ່ຢູ່,ຊື່ຜູ້ໃຊ້,ນ້ຳໜັກຄະແນນ\", ຫຼື \"ທີ່ຢູ່,,ນ້ຳໜັກຄະແນນ\" ໂ"
"ດຍທີ່ \"ທີ່ຢູ່\" ແມ່ນທີ່ຢູ່ອີເມວ, \"ຊື່ຜູ້ໃຊ້\" ແມ່ນຊື່ຜູ້ໃຊ້ທີ່ກ່ຽວຂ້ອງເພື່ອໃຊ້ໃນການຢືນຢັນຕົວຕົນ, ແລະ \"ນ້ຳໜັກຄະ"
"ແນນ\" ແມ່ນຈຳນວນຄະແນນສຽງຂອງຜູ້ມີສິດເລືອກຕັ້ງ (ໃນກໍລະນີທີ່ຜູ້ມີສິດເລືອກຕັ້ງມີຈຳນວນຄະແນນສຽງບໍ່ເທົ່າກັນ)."

#: src/web/clients/basic/admin_basic.ml:217
msgid "Archived elections"
msgstr "ການເລືອກຕັ້ງທີ່ຈັດເກັບແລ້ວ"

#: src/web/clients/admin/admin.ml:211
msgid "Archived elections:"
msgstr "ການເລືອກຕັ້ງທີ່ຈັດເກັບແລ້ວ:"

#: src/web/clients/admin/elections.ml:413
msgid "Are you sure you want to delete this election?"
msgstr "ທ່ານແນ່ໃຈບໍວ່າຕ້ອງການລຶບການເລືອກຕັ້ງນີ້?"

#: src/web/clients/admin/questions.ml:923
msgid "Are you sure you want to delete this question?"
msgstr "ທ່ານແນ່ໃຈບໍວ່າຕ້ອງການລຶບຄຳຖາມນີ້?"

#: src/web/clients/admin/trustees_tab.ml:257
msgid "Are you sure you want to restart from scratch?"
msgstr "ທ່ານແນ່ໃຈບໍວ່າຕ້ອງການເລີ່ມຕົ້ນໃໝ່ທັງໝົດ?"

#: src/web/clients/admin/elections.ml:335
msgid "Are you sure you want to tally this election?"
msgstr "ທ່ານແນ່ໃຈບໍວ່າຕ້ອງການນັບຄະແນນການເລືອກຕັ້ງນີ້?"

#: src/web/clients/admin/trustees_tab.ml:268
msgid "Are you sure you want to validate the board? Changes will no longer be possible."
msgstr "ທ່ານແນ່ໃຈບໍວ່າຕ້ອງການຢືນຢັນຄະນະກຳມະການ? ຈະບໍ່ສາມາດປ່ຽນແປງຂໍ້ມູນໄດ້ອີກ."

#: src/web/clients/trustee/shuffle.ml:99
msgid "As a trustee, your first role is to shuffle the encrypted ballots."
msgstr ""
"ໃນນາມຜູ້ຮັກສາລະຫັດ, ບົດບາດທຳອິດຂອງທ່ານແມ່ນການສັບປ່ຽນ (shuffle) ບັດເລືອກຕັ້ງທີ່ຖືກເຂົ້າລະຫັດໄວ້."

#: src/web/clients/admin/account.ml:144
msgid "Authentication method: "
msgstr "ວິທີການຢືນຢັນຕົວຕົນ: "

