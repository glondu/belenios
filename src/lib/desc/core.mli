(** Type descriptions, interpreted by separate modules ({!Desc.Json}, later a
    schema/doc generator, CBOR…). They are generated by [ppx_desc] for types
    with [[@@deriving desc]].

    The type is [private]: interpreters match on it, but descriptions are only
    built with the smart constructors below, which check the invariants (no
    ambiguous [option], disjoint {!untagged} cases, [Rec] only through {!fix}).
*)

type json = Yojson.Safe.t

type _ t = private
  | Unit : unit t
  | Bool : bool t
  | Int : int t
  | Int64 : int64 t
  | String : string t
  | Json : json t  (** Any JSON value, kept as is. *)
  | List : 'a t -> 'a list t
  | Option : 'a t -> 'a option t  (** As a value: [None] is [null]. *)
  | Tuple : { elts : ('r, 'f) elts; make : 'f } -> 'r t
  | Assoc : { value : 'a t; sorted : bool } -> (string * 'a) list t
      (** An object. If [sorted], the encoder sorts keys in byte order (maps);
          otherwise it keeps list order. *)
  | Map : { base : 'a t; inj : 'a -> 'b; prj : 'b -> 'a } -> 'b t
  | Record : { fields : ('r, 'f) fields; make : 'f } -> 'r t
  | Variant : {
      cases : 'v any_case list;
      classify : 'v -> 'v case_value;
    }
      -> 'v t
  | Untagged : {
      cases : 'v any_case list;
      classify : 'v -> 'v case_value;
    }
      -> 'v t
      (** Each case is written as its argument alone; decoding picks the first
          case whose argument accepts the JSON kind. *)
  | Custom : {
      name : string;
      to_json : 'a -> json;
      of_json : json -> 'a;
    }
      -> 'a t
      (** Hand-written JSON converters, opaque to other interpreters. *)
  | Rec : { name : string; body : 'a t Lazy.t } -> 'a t

and ('r, 'a) elt = { ty : 'a t; get : 'r -> 'a }

and ('r, 'f) elts =
  | Nil : ('r, 'r) elts
  | Cons : ('r, 'a) elt * ('r, 'f) elts -> ('r, 'a -> 'f) elts

and ('r, 'a) field = { name : string; kind : 'a field_kind; get : 'r -> 'a }

and _ field_kind =
  | Required : 'a t -> 'a field_kind
  | Optional : 'a t -> 'a option field_kind
      (** Left out when [None], [None] when missing. *)
  | Default : {
      ty : 'a t;
      default : 'a;
      equal : 'a -> 'a -> bool;
    }
      -> 'a field_kind
      (** Left out when equal to [default], [default] when missing. *)

and ('r, 'f) fields =
  | Fnil : ('r, 'r) fields
  | Fcons : ('r, 'a) field * ('r, 'f) fields -> ('r, 'a -> 'f) fields

and ('v, 'a) case = { tag : string; arg : 'a case_arg; inj : 'a -> 'v }
and _ case_arg = No_arg : unit case_arg | Arg : 'a t -> 'a case_arg
and 'v any_case = Any : ('v, 'a) case -> 'v any_case
and 'v case_value = Value : ('v, 'a) case * 'a -> 'v case_value

exception Invalid of string
(** Raised by smart constructors on an invalid description. *)

(** {2 Base types} *)

val unit : unit t
val bool : bool t
val int : int t
val int64 : int64 t
val string : string t
val json : json t

(** {2 Containers} *)

val list : 'a t -> 'a list t
val array : 'a t -> 'a array t

val option : 'a t -> 'a option t
(** Raises {!Invalid} if [null] may already stand for a value of the argument
    ([option (option x)], [option unit], [option json]…). *)

val assoc : 'a t -> (string * 'a) list t
(** An object, keys in list order (association lists). *)

val sorted_assoc : 'a t -> (string * 'a) list t
(** An object, keys sorted in byte order by the encoder (maps such as [smap],
    [hmap], through {!map}). *)

(** {2 Tuples} *)

val tuple : ('r, 'f) elts -> 'f -> 'r t
val tup2 : 'a t -> 'b t -> ('a * 'b) t
val tup3 : 'a t -> 'b t -> 'c t -> ('a * 'b * 'c) t
val tup4 : 'a t -> 'b t -> 'c t -> 'd t -> ('a * 'b * 'c * 'd) t
val tup5 : 'a t -> 'b t -> 'c t -> 'd t -> 'e t -> ('a * 'b * 'c * 'd * 'e) t

(** {2 Records} *)

val field : string -> 'a t -> ('r -> 'a) -> ('r, 'a) field
val optional : string -> 'a t -> ('r -> 'a option) -> ('r, 'a option) field

val default :
  ?equal:('a -> 'a -> bool) ->
  string ->
  'a t ->
  'a ->
  ('r -> 'a) ->
  ('r, 'a) field
(** [equal] defaults to [( = )]. *)

val record : ('r, 'f) fields -> 'f -> 'r t
(** Raises {!Invalid} on duplicate field names. *)

(** {2 Variants} *)

val const : string -> 'v -> ('v, unit) case
val case : string -> 'a t -> ('a -> 'v) -> ('v, 'a) case

val variant : 'v any_case list -> ('v -> 'v case_value) -> 'v t
(** Raises {!Invalid} on duplicate tags. *)

val untagged : 'v any_case list -> ('v -> 'v case_value) -> 'v t
(** Raises {!Invalid} if a case has no argument, or if a case may produce a JSON
    kind accepted by an earlier case (a case whose kinds are unknown, e.g.
    {!custom}, is only allowed last). *)

(** {2 Other} *)

val map : 'a t -> ('a -> 'b) -> ('b -> 'a) -> 'b t
(** [inj] may raise [Failure] or [Invalid_argument] on invalid input; decoders
    turn that into a decoding error. *)

val custom : string -> ('a -> json) -> (json -> 'a) -> 'a t

val fix : string -> ('a t -> 'a t) -> 'a t
(** The only way to build a [Rec]. The body is forced before returning: no
    unforced [lazy] escapes (safe with domains). [f] must only reference its
    argument, otherwise [Lazy.Undefined] is raised. *)

(** {2 JSON kinds} *)

type kind = Knull | Kbool | Kint | Kfloat | Kstring | Klist | Kobject

val kinds : 'a t -> kind list option
(** The JSON kinds a description may produce, [None] if unknown ({!json},
    {!custom}, a [Rec] being built). Used by {!option}, {!untagged} and
    decoders. *)
